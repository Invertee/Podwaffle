{
  "name": "podwaffle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @podwaffle/contracts build && pnpm --filter @podwaffle/web build && pnpm --filter @podwaffle/server build",
    "dev": "pnpm --parallel --filter @podwaffle/server --filter @podwaffle/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/server apps/web packages/contracts",
    "typecheck": "pnpm --parallel --filter @podwaffle/contracts --filter @podwaffle/server --filter @podwaffle/web typecheck",
    "test": "pnpm --filter @podwaffle/contracts build && pnpm --parallel --filter @podwaffle/server --filter @podwaffle/web test",
    "test:integration": "pnpm --filter @podwaffle/server test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
